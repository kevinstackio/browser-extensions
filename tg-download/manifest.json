{
  "manifest_version": 3,
  "name": "TG Download",
  "version": "1.0.0",
  "description": "在 Telegram Web 中右键保存图片和视频。",
  "content_scripts": [
    {
      "matches": ["https://web.telegram.org/*"],
      "css": ["src/styles/menu.css"],
      "js": ["src/components/menu/index.js", "src/views/download/index.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
